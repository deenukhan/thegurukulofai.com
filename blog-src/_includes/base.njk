<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} · {{ site.name }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="author" content="{{ site.author }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url | url }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
  {% if cover %}<meta property="og:image" content="{{ cover }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/images/favicon.png">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://tgai-cdn-2.b-cdn.net">
  <link rel="preconnect" href="https://iframe.mediadelivery.net">
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <!-- Stylesheets (shared brand + blog) -->
  <link rel="stylesheet" href="/css/base.css?v=37">
  <link rel="stylesheet" href="/css/components.css?v=38">
  <link rel="stylesheet" href="/css/sections.css?v=41">
  <link rel="stylesheet" href="/css/responsive.css?v=39">
  <link rel="stylesheet" href="/css/blog.css?v={{ site.cssVersion }}">
  <link rel="stylesheet" href="/css/nav-mobile.css?v=1">

  {% if isPost %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | dump | safe }},
    "description": {{ description | dump | safe }},
    {% if cover %}"image": {{ cover | dump | safe }},{% endif %}
    "datePublished": "{{ page.date | isoDate }}",
    "dateModified": "{{ page.date | isoDate }}",
    "author": { "@type": "Person", "name": {{ site.author | dump | safe }} },
    "publisher": {
      "@type": "Organization",
      "name": {{ site.name | dump | safe }},
      "logo": { "@type": "ImageObject", "url": "{{ site.url }}/assets/images/logo-tgai.png" }
    },
    "mainEntityOfPage": "{{ site.url }}{{ page.url | url }}"
  }
  </script>
  {% endif %}
</head>
<body class="blog-body">

  <!-- ===================== NAVIGATION ===================== -->
  <nav class="nav" id="nav" role="navigation" aria-label="Main navigation">
    <div class="js-nav-pill nav-inner">
      <a href="/" class="logo" aria-label="The Gurukul of AI, Home">
        <img src="/assets/images/logo-tgai.png" alt="The Gurukul of AI" class="logo-img">
      </a>
      <ul id="navMenu" class="nav-links js-nav-menu" role="list">
        <li><a href="/#courses">Courses</a></li>
        <li><a href="/#founder">About</a></li>
        <li><a href="/portfolio/">Ads Portfolio</a></li>
        <li><a href="/gallery/">Gallery</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/free-guides.html">Free Guides</a></li>
        <li><a href="https://instagram.com/neuraltech.ai" target="_blank" rel="noopener noreferrer">@neuraltech.ai</a></li>
      </ul>
      <button type="button" class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="navMenu">
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
      <a href="https://academy.thegurukulofai.com/login" class="btn btn-nav" target="_blank" rel="noopener noreferrer">Login</a>
    </div>
  </nav>

  {{ content | safe }}

  <!-- ===================== FOOTER ===================== -->
  <footer class="footer" role="contentinfo">
    <div class="footer-inner">
      <div class="footer-top">
        <div class="footer-brand">
          <div class="footer-logo">
            <img src="/assets/images/logo-tgai.png" alt="The Gurukul of AI" class="footer-logo-img">
          </div>
          <p class="footer-tagline">Practical AI education for Indian creators, brand builders, and entrepreneurs.</p>
        </div>
        <div class="footer-col">
          <h4 class="footer-heading">Courses</h4>
          <ul class="footer-links" role="list">
            <li><a href="/#courses">GenAI Mastery</a></li>
            <li><a href="/#courses">AI Influencer Mastery</a></li>
            <li><a href="/#courses">AI UGC Mastery</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="footer-heading">Brand</h4>
          <ul class="footer-links" role="list">
            <li><a href="/#founder">About Deenu</a></li>
            <li><a href="/portfolio/">Ads Portfolio</a></li>
            <li><a href="/gallery/">Gallery</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/free-guides.html">Free Guides</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="footer-heading">Connect</h4>
          <ul class="footer-links" role="list">
            <li><a href="https://instagram.com/neuraltech.ai" target="_blank" rel="noopener noreferrer">@neuraltech.ai</a></li>
            <li><a href="https://youtube.com/@neuraltechai" target="_blank" rel="noopener noreferrer">YouTube</a></li>
            <li><a href="/privacy-policy.html">Privacy Policy</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-divider" aria-hidden="true"></div>
      <div class="footer-bottom">
        <span class="footer-copy">© 2026 The Gurukul of AI. All rights reserved.</span>
        <nav class="footer-social" aria-label="Social links">
          <a href="https://instagram.com/neuraltech.ai" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="https://youtube.com/@neuraltechai" target="_blank" rel="noopener noreferrer">YouTube</a>
          <a href="https://www.linkedin.com/in/deenu-khan-a4a33b356/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </nav>
      </div>
    </div>
  </footer>

  <script src="/js/nav-mobile.js?v=1"></script>
</body>
</html>
